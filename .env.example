APP_NAME=SKEDYUL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_CONNECT_TIMEOUT=5
DB_DATABASE=postgres
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# In Laravel Cloud, attach two Object Storage buckets to this environment:
# a PUBLIC bucket for profile photos and a PRIVATE bucket for ID photos/templates.
# Use these disk names in Cloud when attaching the buckets.
PROFILE_IMAGES_DISK=skedyul_public
PRIVATE_UPLOADS_DISK=skedyul_private
EXPORT_TEMPLATES_DISK=skedyul_private
EXPORT_TEMPLATES_PREFIX=templates

WEBAUTHN_RP_ID=skedyul-production-jblkxy.laravel.cloud
WEBAUTHN_RP_NAME=SKEDYUL
WEBAUTHN_ORIGIN=https://skedyul-production-jblkxy.laravel.cloud

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
